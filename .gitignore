# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# Environments and secrets
.env
.remote_credentials.json
.venv/
venv/

# OS and editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log
# ...except the shipped run logs: lane launcher logs and the vLLM server headers
# (the only record of the vLLM version behind the local precision runs).
!outputs/*.log

# Course data and derived artefacts are not redistributed (see THIRD_PARTY_NOTICES.md)
documents/
embeddings/
dataset/
mine/raw/
*.npy
*.npz
*_test_data.json

# Run exports: `skyrag eval` writes a CSV beside each JSON with the same rows;
# the shipped runs keep the JSON only, which is what the analysis scripts read.
*.csv
# Scratch runs (the README's examples and the preflight live step write here)
outputs/scratch_*/

# Regenerated by scripts/plot_figures.py
figures/
